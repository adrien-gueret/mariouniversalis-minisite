{
  "name": "mariouniversalis-minisite",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "gatsby clean && gatsby build --prefix-paths",
    "develop": "gatsby develop --open",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve --prefix-paths",
    "clean": "gatsby clean"
  },
  "dependencies": {
    "algoliasearch": "^4.27.0",
    "babel-plugin-styled-components": "^2.3.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-plugin-typography": "^5.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-source-graphql": "^5.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-instantsearch-hooks-web": "^6.47.3",
    "react-typography": "^0.16.23",
    "styled-components": "^5.3.11",
    "typography": "^0.16.24",
    "typography-theme-fairy-gates": "^0.16.19"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
